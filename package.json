{
  "name": "sweepstash",
  "private": true,
  "version": "0.1.0",
  "description": "SweepStash — consolidate crypto dust into one asset on Monad.",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "compile": "hardhat compile",
    "deploy:tokens": "hardhat run scripts/deploy.ts --network monadTestnet",
    "seed:pools": "hardhat run scripts/seedPools.ts --network monadTestnet",
    "test:swap": "hardhat run scripts/testSwap.ts --network monadTestnet",
    "dev": "npm run dev --workspace frontend"
  },
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.14",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "chai": "^6.2.2",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "hardhat": "^3.9.1",
    "mocha": "^11.7.6",
    "solc": "^0.8.28",
    "typescript": "^5.9.3"
  }
}
